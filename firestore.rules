rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function me(uid) { return signed() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }
    function orderPath(id) { return /databases/$(db)/documents/orders/$(id); }
    // price of a package for a given wallet (0 = not available in that wallet)
    function optPrice(pid, idx, w) {
      let opt = get(/databases/$(db)/documents/products/$(pid)).data.options[idx];
      return opt.get('prices', {}).get(w, opt.get('price', 0));
    }

    // purchase: exactly one wallet goes down by the price of a NEW order written in the same transaction
    function purchaseOk(uid) {
      let oid = request.resource.data.lastOrder;
      let o = getAfter(orderPath(oid)).data;
      let w = o.wallet;
      return !exists(orderPath(oid))
        && o.uid == uid
        && request.resource.data.wallets.diff(resource.data.wallets).affectedKeys().hasOnly([w])
        && request.resource.data.wallets[w] is int
        && request.resource.data.wallets[w] >= 0
        && request.resource.data.wallets[w] == resource.data.wallets.get(w, 0) - o.price;
    }

    match /admins/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if false;
    }

    match /adminTokens/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['name','email','phone','photo','short','wallets','defWallet','createdAt'])
        && request.resource.data.wallets is map && request.resource.data.wallets.size() == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isAdmin() || (me(uid) && (
          // profile edit
          (changed().hasOnly(['name','phone'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 60
            && request.resource.data.phone is string && request.resource.data.phone.size() <= 20)
          // choose default wallet
          || (changed().hasOnly(['defWallet'])
            && request.resource.data.defWallet is string && request.resource.data.defWallet.size() <= 20)
          // old accounts: add empty wallets map once
          || (changed().hasOnly(['wallets'])
            && !('wallets' in resource.data)
            && request.resource.data.wallets is map && request.resource.data.wallets.size() == 0)
          // purchase
          || ('wallets' in resource.data && changed().hasOnly(['wallets','lastOrder']) && purchaseOk(uid))
        ));
      allow delete: if false;
    }

    match /orders/{oid} {
      allow read: if (signed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','uName','uShort','productId','productName','optionIndex','optionLabel','price','wallet','cur','input','no','status','createdAt','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.wallet is string
        && request.resource.data.price is int && request.resource.data.price > 0
        && request.resource.data.input is string && request.resource.data.input.size() <= 200
        && get(/databases/$(db)/documents/products/$(request.resource.data.productId)).data.active == true
        && get(/databases/$(db)/documents/products/$(request.resource.data.productId)).data.name == request.resource.data.productName
        && get(/databases/$(db)/documents/products/$(request.resource.data.productId)).data.options[request.resource.data.optionIndex].label == request.resource.data.optionLabel
        && request.resource.data.price == optPrice(request.resource.data.productId, request.resource.data.optionIndex, request.resource.data.wallet)
        && getAfter(userPath(request.auth.uid)).data.lastOrder == oid
        && getAfter(userPath(request.auth.uid)).data.wallets[request.resource.data.wallet] == get(userPath(request.auth.uid)).data.wallets.get(request.resource.data.wallet, 0) - request.resource.data.price;
      allow update, delete: if isAdmin();
    }

    match /topups/{id} {
      allow read: if (signed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (signed()
        && request.resource.data.keys().hasOnly(['uid','uName','uShort','method','methodName','wallet','cur','amount','fields','shot','note','status','createdAt','updatedAt'])
        && request.resource.data.fields is map && request.resource.data.fields.size() <= 12
        && request.resource.data.shot is string && request.resource.data.shot.size() <= 900000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.method != 'admin'
        && request.resource.data.wallet == request.resource.data.method
        && request.resource.data.wallet is string && request.resource.data.wallet.size() <= 20
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
        && request.resource.data.note is string && request.resource.data.note.size() <= 300);
      allow update, delete: if isAdmin();
    }

    match /tickets/{id} {
      allow read: if (signed() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','uName','uShort','type','message','status','reply','createdAt','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reply == ''
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500;
      allow update, delete: if isAdmin();
    }

    // everything else (old project data) is closed
    match /{document=**} { allow read, write: if false; }
  }
}
